<Application x:Class="CloudBookReader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <Style x:Key="NormalWindow" TargetType="Window">
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#FFFDF5E6" />
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="DarkGreen" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="DarkRed" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <Style x:Key="GrayButton" TargetType="Button">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontFamily" Value="Arial" />
        </Style>

        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource GrayButton}">
            <Setter Property="Background" Value="DarkGreen" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource GrayButton}">
            <Setter Property="Background" Value="DarkRed" />
            <Setter Property="Foreground" Value="White" />
        </Style>

    </Application.Resources>
</Application>
