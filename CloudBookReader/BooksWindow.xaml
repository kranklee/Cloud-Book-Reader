<Window x:Class="CloudBookReader.BooksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cloud Book Reader - My Books" Height="480" Width="620"
        FontFamily="Arial" Background="#FFFDF5E6"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="UserTextBlock" Text="Logged in as:" FontSize="16"
                   FontWeight="Bold" Foreground="DarkGreen" Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Search (title or author)" VerticalAlignment="Center" />
            <TextBox x:Name="SearchTextBox" Width="250" Height="24"
                     TextChanged="SearchTextBox_TextChanged" />
        </StackPanel>

        <ListBox Grid.Row="2" x:Name="BooksListBox" FontSize="13"
                 MouseDoubleClick="BooksListBox_MouseDoubleClick" />

        <TextBlock Grid.Row="3" x:Name="StatusTextBlock" Margin="0,8,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="OpenButton" Content="Open Book" Width="100" Height="30"
                    Background="DarkGreen" Foreground="White" Click="OpenButton_Click" />
            <Button x:Name="RefreshButton" Content="Refresh" Width="100" Height="30" Margin="10,0,0,0"
                    Click="RefreshButton_Click" />
            <Button x:Name="LogoutButton" Content="Logout" Width="100" Height="30" Margin="10,0,0,0"
                    Background="DarkRed" Foreground="White" Click="LogoutButton_Click" />
        </StackPanel>
    </Grid>
</Window>
