<Window x:Class="CloudBookReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cloud Book Reader" Height="320" Width="400"
        FontFamily="Arial" Background="#FFFDF5E6"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Cloud Book Reader" FontSize="22" FontWeight="Bold"
                   Foreground="DarkGreen" Margin="0,0,0,15" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="User ID" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="UserIdTextBox" Height="24" />

            <Label Grid.Row="1" Grid.Column="0" Content="Password" VerticalAlignment="Center" />
            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PasswordInput" Height="24" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="90,15,0,0">
            <Button x:Name="LoginButton" Content="Login" Width="80" Height="28" IsDefault="True"
                    Background="DarkGreen" Foreground="White" Click="LoginButton_Click" />
            <Button x:Name="ClearButton" Content="Clear" Width="80" Height="28" Margin="10,0,0,0"
                    Background="DarkRed" Foreground="White" Click="ClearButton_Click" />
        </StackPanel>

        <TextBlock x:Name="MessageTextBlock" Foreground="DarkRed" TextWrapping="Wrap"
                   Margin="0,15,0,0" />
    </StackPanel>
</Window>
